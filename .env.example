# ==============================================================================
# AGENTIC CHASE - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY AI MODEL: GOOGLE GEMINI
# ------------------------------------------------------------------------------
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended best model: gemini-2.5-flash
# (Handles voice note .opus transcription, images, videos, and long chat histories)
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. BACKUP / FAILOVER API (OPTIONAL)
# ------------------------------------------------------------------------------
# If Gemini is rate-limited or fails, the platform automatically switches
# to your backup provider so the agents never stop answering.
# Options:
# Provider 'groq': Blazing fast Llama 3.3 70B (free tier at https://console.groq.com/)
# Provider 'openai': GPT-4o-mini (https://platform.openai.com/)
BACKUP_API_PROVIDER=groq
BACKUP_API_KEY=your_groq_or_openai_api_key_here
BACKUP_MODEL=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 3. LOCAL STORAGE MODE (NO DATABASE REQUIRED)
# ------------------------------------------------------------------------------
# Uses pure local JSON files for persistent storage and deletion
USE_LOCAL_STORAGE=true
